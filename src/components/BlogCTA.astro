---
// End-of-article CTA. Opens the booking dialog on the post's own topic: the free asesoría
// session for process/automation posts, or the matching secondary service.
import { topicCopy } from "../data/booking";

interface Props {
  topic: string;
}
const { topic } = Astro.props;
const isSession = topic === "";
const copy = topicCopy(topic);
---

<div class="relative overflow-hidden rounded-[28px] bg-ink px-8 py-12 text-white sm:px-12">
  <div aria-hidden="true" class="cta-glow pointer-events-none absolute inset-0"></div>
  <div class="relative">
    <h2 class="text-[clamp(1.8rem,3.2vw,2.5rem)] font-bold leading-[1.05] tracking-[-0.045em]">¿Quieres aplicar esto en tu negocio?</h2>
    <p class="mt-4 max-w-[52ch] text-[1.08rem] leading-relaxed text-white/70">
      {isSession
        ? "Cuéntanos qué tareas repetitivas os quitan más tiempo. En 30 minutos te decimos por cuál empezaríamos y cuánto te ahorraría."
        : copy.description}
    </p>
    <a
      href={isSession ? "/contacto" : `/contacto?servicio=${topic}`}
      data-open-booking={topic}
      class="mt-8 inline-block rounded-full bg-white px-7 py-4 text-[1.02rem] font-semibold text-ink transition hover:bg-[#c9c0ff]"
    >
      {isSession ? "Reservar mi sesión gratuita" : "Cuéntanos tu caso"}
    </a>
  </div>
</div>

<style>
  .cta-glow {
    background:
      radial-gradient(55% 90% at 100% 0%, rgba(109, 85, 255, 0.5), transparent 70%),
      radial-gradient(40% 70% at 0% 100%, rgba(63, 211, 191, 0.16), transparent 70%);
  }
</style>
