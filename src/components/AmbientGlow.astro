---
// Slow-drifting colour glow behind the whole site — sits between the flat black
// background and the actual content (z-index: -1 keeps it out of the way of clicks
// and reading, `position: fixed` makes it drift independently of page scroll).
---

<div class="ambient-glow" aria-hidden="true">
  <span class="glow glow-a"></span>
  <span class="glow glow-b"></span>
  <span class="glow glow-c"></span>
</div>

<style>
  .ambient-glow {
    position: fixed;
    inset: 0;
    /* 0, not a negative value: real page content is wrapped in its own `relative z-10`
       stacking context in Layout.astro, so this only needs to stay below that boundary —
       a negative z-index here was empirically swallowed entirely behind the body's own
       background in testing, rather than sitting visibly on top of it as spec order
       would suggest. */
    z-index: 0;
    overflow: hidden;
    pointer-events: none;
  }

  .glow {
    position: absolute;
    border-radius: 9999px;
    filter: blur(100px);
    opacity: 0.4;
    will-change: transform, border-radius, filter;
  }

  .glow-a {
    top: -12%;
    left: -12%;
    width: 48vw;
    height: 48vw;
    background: radial-gradient(circle at 30% 30%, #8b5cf6, transparent 70%);
    animation: drift-a 24s ease-in-out infinite alternate;
  }

  .glow-b {
    right: -10%;
    bottom: -14%;
    width: 42vw;
    height: 42vw;
    background: radial-gradient(circle at 60% 40%, #f59e0b, transparent 70%);
    animation: drift-b 30s ease-in-out infinite alternate;
  }

  .glow-c {
    top: 32%;
    left: 58%;
    width: 36vw;
    height: 36vw;
    background: radial-gradient(circle at 50% 50%, #ec4899, transparent 70%);
    animation: drift-c 20s ease-in-out infinite alternate;
  }

  /* Each blob drifts, breathes in scale, morphs its outline like a lava-lamp blob
     (asymmetric border-radius) and drifts a little in hue — not just position — so
     the background reads as alive rather than three static circles sliding around. */
  @keyframes drift-a {
    0% {
      transform: translate(0, 0) scale(1);
      border-radius: 42% 58% 65% 35% / 45% 45% 55% 55%;
      filter: blur(100px) hue-rotate(0deg);
    }
    50% {
      transform: translate(4vw, 5vh) scale(1.08);
      border-radius: 60% 40% 38% 62% / 55% 62% 38% 45%;
      filter: blur(100px) hue-rotate(30deg);
    }
    100% {
      transform: translate(7vw, 9vh) scale(1.15);
      border-radius: 65% 35% 50% 50% / 40% 55% 45% 60%;
      filter: blur(100px) hue-rotate(0deg);
    }
  }

  @keyframes drift-b {
    0% {
      transform: translate(0, 0) scale(1);
      border-radius: 55% 45% 40% 60% / 50% 40% 60% 50%;
      filter: blur(100px) hue-rotate(0deg);
    }
    50% {
      transform: translate(-5vw, -4vh) scale(1.05);
      border-radius: 38% 62% 60% 40% / 62% 50% 50% 38%;
      filter: blur(100px) hue-rotate(-25deg);
    }
    100% {
      transform: translate(-9vw, -7vh) scale(1.1);
      border-radius: 45% 55% 50% 50% / 55% 45% 55% 45%;
      filter: blur(100px) hue-rotate(0deg);
    }
  }

  @keyframes drift-c {
    0% {
      transform: translate(0, 0) scale(1);
      border-radius: 50% 50% 55% 45% / 45% 55% 45% 55%;
      filter: blur(100px) hue-rotate(0deg);
    }
    50% {
      transform: translate(-3vw, 3vh) scale(0.94);
      border-radius: 62% 38% 42% 58% / 58% 42% 58% 42%;
      filter: blur(100px) hue-rotate(40deg);
    }
    100% {
      transform: translate(-6vw, 6vh) scale(0.88);
      border-radius: 40% 60% 60% 40% / 50% 50% 50% 50%;
      filter: blur(100px) hue-rotate(0deg);
    }
  }

  @media (prefers-reduced-motion: reduce) {
    .glow {
      animation: none;
    }
  }
</style>
