---
// NOTE: these three quotes are illustrative placeholders (explicitly requested by the
// client as "invéntate las 3 citas"), not real customer reviews. Swap them for genuine
// testimonials as soon as they exist — presenting fabricated quotes as real reviews is
// a real legal/reputational risk in Spain (unfair commercial practices rules), so this
// should not stay placeholder content indefinitely.
const testimonials = [
  {
    quote:
      "Antes tardábamos dos días en montar el informe semanal de ventas. Ahora se genera solo y dedicamos ese tiempo a hablar con clientes de verdad.",
    name: "Marta G.",
    role: "Comercio en Jerez de la Frontera",
  },
  {
    quote:
      "La web anterior no nos traía ni un cliente. Desde que la rehicieron, no hemos dejado de recibir citas nuevas cada semana.",
    name: "Antonio R.",
    role: "Clínica en Sevilla",
  },
  {
    quote:
      "Por fin aparecemos los primeros cuando alguien busca nuestro servicio en Google. Se nota directamente en las llamadas que recibimos.",
    name: "Laura M.",
    role: "Empresa de servicios en Cádiz",
  },
];
---

<section class="border-t border-white/10 px-6 py-16">
  <h2 data-reveal class="text-center font-serif text-2xl italic sm:text-3xl">
    Lo que dicen <span class="not-italic text-white/50">quienes ya trabajan con nosotros</span>
  </h2>

  <div class="mx-auto mt-10 grid max-w-5xl gap-6 sm:grid-cols-3">
    {testimonials.map((t, i) => (
      <div
        data-reveal
        data-reveal-delay={i * 120}
        class="flex flex-col rounded-2xl border border-white/10 bg-white/[0.03] p-6"
      >
        <p class="flex-1 text-sm leading-relaxed text-white/80">&ldquo;{t.quote}&rdquo;</p>
        <div class="mt-5 flex items-center gap-3">
          <span class="flex h-9 w-9 shrink-0 items-center justify-center rounded-full bg-white/10 text-xs font-semibold text-white">
            {t.name
              .split(" ")
              .map((n) => n[0])
              .join("")}
          </span>
          <div>
            <p class="text-sm font-semibold text-white">{t.name}</p>
            <p class="text-xs text-white/50">{t.role}</p>
          </div>
        </div>
      </div>
    ))}
  </div>
</section>
