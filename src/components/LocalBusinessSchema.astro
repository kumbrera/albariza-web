---
// Sitewide structured data (every page, via Layout.astro), aligned with the process-consulting
// positioning. Keep it in step with public/llms.txt.
const siteUrl = new URL("/", Astro.url).toString();

const schema = {
  "@context": "https://schema.org",
  "@type": "ProfessionalService",
  name: "Albariza Digital",
  description:
    "Albariza Digital es una asesoría de procesos y automatización para pymes, autónomos y directivos en España. Ordena cómo trabaja la empresa y automatiza las tareas repetitivas con las herramientas que ya usa. También diseña webs y trabaja SEO/GEO y redes sociales.",
  url: siteUrl,
  image: new URL("/brand/og-image.jpg", Astro.url).toString(),
  logo: new URL("/brand/favicon-512.png", Astro.url).toString(),
  telephone: "+34601386534",
  email: "albarizadigital@gmail.com",
  areaServed: { "@type": "Country", name: "España" },
  address: {
    "@type": "PostalAddress",
    addressRegion: "Andalucía",
    addressCountry: "ES",
  },
  makesOffer: [
    { "@type": "Offer", itemOffered: { "@type": "Service", name: "Asesoría de procesos y automatización" } },
    { "@type": "Offer", itemOffered: { "@type": "Service", name: "Diseño y desarrollo web" } },
    { "@type": "Offer", itemOffered: { "@type": "Service", name: "Posicionamiento SEO y GEO" } },
    { "@type": "Offer", itemOffered: { "@type": "Service", name: "Gestión de redes sociales" } },
  ],
};
---

<script type="application/ld+json" set:html={JSON.stringify(schema)} />
