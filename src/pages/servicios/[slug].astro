---
import Layout from "../../layouts/Layout.astro";
import FaqSection from "../../components/FaqSection.astro";
import { services } from "../../data/services";
import { ASESORIA_PATH } from "../../data/routes";
import { ORG_ID, SITE, breadcrumbs } from "../../data/schema";

export function getStaticPaths() {
  return services.map((service) => ({
    params: { slug: service.slug },
    props: { service },
  }));
}

const { service } = Astro.props;
const others = services.filter((s) => s.slug !== service.slug);

// The web page shows a site being browsed, so it gets a browser frame and its own clip.
const isWeb = service.slug === "web";
const heroVideo = isWeb ? "/videos/web-mockup.mp4" : service.video;

const extras: Record<string, { title: string; items: { label: string; text: string }[] }> = {
  "seo-geo": {
    title: "Dos formas de que te encuentren.",
    items: [
      { label: "SEO", text: "Apareces en Google, en el mapa y en los resultados de tu zona cuando alguien busca lo que vendes." },
      { label: "GEO", text: "ChatGPT, Gemini o las respuestas de Google te citan como opción, porque tu contenido responde claro y bien estructurado." },
    ],
  },
  "social-media": {
    title: "Contenido con sistema, no al azar.",
    items: [
      { label: "Educa", text: "Resuelve una duda real de tu cliente." },
      { label: "Muestra", text: "Proceso, equipo y producto, sin postureo." },
      { label: "Vende", text: "Una sola llamada a la acción, clara." },
      { label: "Conecta", text: "Comunidad y cercanía con quien ya te sigue." },
    ],
  },
  web: {
    title: "Una web que trabaja, no una tarjeta de visita.",
    items: [
      { label: "Rápida", text: "Carga al momento en el móvil, que es donde te miran." },
      { label: "Clara", text: "Una llamada a la acción en cada página, sin que el cliente tenga que buscarla." },
      { label: "Encontrable", text: "SEO técnico desde el primer día, no añadido después." },
    ],
  },
};
const extra = extras[service.slug];

const serviceLd = {
  "@context": "https://schema.org",
  "@type": "Service",
  name: service.name,
  description: service.description,
  provider: { "@id": ORG_ID },
  url: `${SITE}/servicios/${service.slug}/`,
  areaServed: { "@type": "Country", name: "España" },
};
---

<Layout title={`${service.name} para pymes y autónomos | Albariza Digital`} description={service.description}>
  <script type="application/ld+json" set:html={JSON.stringify(serviceLd)} />
  <script type="application/ld+json" set:html={JSON.stringify(breadcrumbs([["Inicio", "/"], ["Servicios", "/#servicios"], [service.name, `/servicios/${service.slug}/`]]))} />

  <!-- Hero -->
  <section class="relative overflow-x-clip">
    <div aria-hidden="true" class="service-light pointer-events-none absolute right-[-10%] top-[-10%] h-[120%] w-[75%]"></div>
    <div class="relative mx-auto grid max-w-7xl items-center gap-12 px-6 pb-20 pt-10 lg:grid-cols-12 lg:gap-12 lg:pb-28 lg:pt-16">
      <div class="lg:col-span-6">
        <p class="text-[1rem] font-medium text-violet">
          <a href="/#servicios" class="text-graphite transition hover:text-ink">Servicios</a>
          <span class="mx-1.5 text-graphite/50">/</span>{service.name}
        </p>
        <h1 class="mt-4 max-w-[14ch] text-[clamp(2.6rem,5vw,4.4rem)] font-bold leading-[0.98]">
          {service.tagline.normal} <span class="text-violet">{service.tagline.emphasis}.</span>
        </h1>
        <p class="mt-6 max-w-[48ch] text-[1.12rem] leading-relaxed text-graphite">{service.description}</p>
        <div class="mt-8 flex flex-wrap items-center gap-x-6 gap-y-4">
          <a
            href={`/contacto/?servicio=${service.slug}`}
            data-open-booking={service.slug}
            class="rounded-full bg-violet px-7 py-4 text-[1.02rem] font-semibold text-white shadow-[0_14px_30px_-12px_rgba(79,50,224,0.7)] transition hover:bg-ink focus-visible:outline-2 focus-visible:outline-offset-4 focus-visible:outline-violet"
          >
            Cuéntanos tu caso
          </a>
          <a href="#como" class="text-[1.02rem] font-semibold text-ink underline decoration-ink/25 underline-offset-[6px] transition hover:decoration-ink">
            Cómo lo hacemos
          </a>
        </div>
      </div>

      <div class="lg:col-span-6">
        <div class="overflow-hidden rounded-[26px] border border-ink/8 bg-white/60 p-2.5 shadow-[0_40px_80px_-40px_rgba(22,21,31,0.45)] backdrop-blur-sm">
          {isWeb && (
            <div class="flex items-center gap-2 px-3 pb-2.5 pt-1.5">
              <span class="h-2.5 w-2.5 rounded-full bg-[#ff5f57]"></span>
              <span class="h-2.5 w-2.5 rounded-full bg-[#febc2e]"></span>
              <span class="h-2.5 w-2.5 rounded-full bg-[#28c840]"></span>
              <span class="ml-3 rounded-full bg-chalk px-3 py-1 text-[0.78rem] text-graphite">tuempresa.com</span>
            </div>
          )}
          <video
            class={`w-full rounded-[18px] bg-ink object-cover ${isWeb ? "aspect-[1280/574]" : "aspect-video"}`}
            src={heroVideo}
            poster={heroVideo.replace("/videos/", "/videos/posters/").replace(".mp4", ".webp")}
            autoplay
            muted
            loop
            playsinline
            preload="metadata"
            aria-hidden="true"
          ></video>
        </div>
      </div>
    </div>
  </section>

  <!-- Qué hacemos -->
  <section class="border-t border-ink/8">
    <div class="mx-auto grid max-w-7xl gap-12 px-6 py-28 lg:grid-cols-12">
      <div class="lg:col-span-5">
        <h2 class="text-[clamp(2.2rem,4.4vw,3.4rem)] font-bold leading-[1.02]">Qué hacemos.</h2>
        <p class="mt-6 max-w-[46ch] text-[1.12rem] leading-relaxed text-graphite">{service.longIntro}</p>
      </div>
      <ul class="grid content-start gap-3 sm:grid-cols-2 lg:col-span-6 lg:col-start-7">
        {service.bullets.map((b) => (
          <li class="flex items-center gap-3.5 rounded-2xl border border-ink/10 bg-white/60 px-5 py-4 text-[1.05rem] font-medium text-ink">
            <span class="flex h-6 w-6 shrink-0 items-center justify-center rounded-full bg-violet text-[0.75rem] text-white" aria-hidden="true">✓</span>
            {b}
          </li>
        ))}
      </ul>
    </div>
  </section>

  {extra && (
    <section class="border-t border-ink/8 bg-white/40">
      <div class="mx-auto max-w-7xl px-6 py-28">
        <h2 class="max-w-[18ch] text-[clamp(2.2rem,4.4vw,3.4rem)] font-bold leading-[1.02]">{extra.title}</h2>
        <ul class={`mt-14 grid gap-4 sm:grid-cols-2 ${extra.items.length === 3 ? "lg:grid-cols-3" : extra.items.length === 4 ? "lg:grid-cols-4" : ""}`}>
          {extra.items.map((item) => (
            <li class="rounded-[24px] border border-ink/8 bg-white/70 p-7">
              <p class="text-[clamp(1.6rem,2.6vw,2.1rem)] font-bold tracking-[-0.04em] text-violet">{item.label}</p>
              <p class="mt-3 text-[1.05rem] leading-relaxed text-graphite">{item.text}</p>
            </li>
          ))}
        </ul>
      </div>
    </section>
  )}

  <!-- Proceso -->
  <section id="como" class="scroll-mt-24 border-t border-ink/8">
    <div class="mx-auto max-w-7xl px-6 py-28">
      <h2 class="text-[clamp(2.2rem,4.4vw,3.4rem)] font-bold leading-[1.02]">Cómo lo hacemos.</h2>
      <ol class="mt-14 grid gap-10 border-t border-ink/10 pt-10 md:grid-cols-3">
        {service.process.map((step, i) => (
          <li>
            <span class="flex h-11 w-11 items-center justify-center rounded-full bg-ink text-[1rem] font-semibold text-white">{i + 1}</span>
            <h3 class="mt-6 text-[1.45rem] font-bold leading-tight tracking-[-0.03em]">{step.title}</h3>
            <p class="mt-3 max-w-[38ch] text-[1.04rem] leading-relaxed text-graphite">{step.text}</p>
          </li>
        ))}
      </ol>
    </div>
  </section>

  <!-- Puente a la asesoría -->
  <section class="px-6 pb-28">
    <div class="relative mx-auto max-w-7xl overflow-hidden rounded-[32px] bg-ink px-8 py-14 text-white sm:px-14 sm:py-16">
      <div aria-hidden="true" class="bridge-light pointer-events-none absolute inset-0"></div>
      <div class="relative grid items-end gap-8 lg:grid-cols-12">
        <div class="lg:col-span-8">
          <p class="text-[0.95rem] font-medium text-[#a99bff]">Nuestro servicio principal</p>
          <h2 class="mt-3 text-[clamp(2rem,3.8vw,3.1rem)] font-bold leading-[1.02]">¿Y si lo que frena al negocio es cómo trabajáis por dentro?</h2>
          <p class="mt-4 max-w-[54ch] text-[1.08rem] leading-relaxed text-white/70">
            Antes de invertir en más visibilidad, a veces conviene ordenar lo que pasa cuando el cliente ya ha llegado: seguimiento, presupuestos, facturas.
          </p>
        </div>
        <div class="lg:col-span-4 lg:text-right">
          <a href={ASESORIA_PATH} class="inline-block rounded-full bg-white px-7 py-4 text-[1.02rem] font-semibold text-ink transition hover:bg-[#a99bff]">
            Ver la asesoría
          </a>
        </div>
      </div>
    </div>
  </section>

  <FaqSection items={service.faq} />

  <!-- Otros servicios + CTA -->
  <section class="border-t border-ink/8">
    <div class="mx-auto max-w-7xl px-6 py-24">
      <div class="flex flex-col items-start justify-between gap-8 md:flex-row md:items-center">
        <div>
          <h2 class="text-[clamp(2rem,3.6vw,3rem)] font-bold leading-[1.05]">{service.ctaLine}.</h2>
          <p class="mt-3 text-[1.1rem] text-graphite">Sin compromiso.</p>
        </div>
        <a
          href={`/contacto/?servicio=${service.slug}`}
          data-open-booking={service.slug}
          class="shrink-0 rounded-full bg-violet px-7 py-4 text-[1.02rem] font-semibold text-white shadow-[0_14px_30px_-12px_rgba(79,50,224,0.7)] transition hover:bg-ink"
        >
          Cuéntanos tu caso
        </a>
      </div>
      <div class="mt-20 border-t border-ink/10 pt-8">
        <p class="text-[0.95rem] text-graphite">También te ayudamos con</p>
        <div class="mt-4 flex flex-wrap gap-3">
          {others.map((s) => (
            <a href={`/servicios/${s.slug}/`} class="rounded-full border border-ink/12 bg-white/50 px-5 py-2.5 text-[1rem] font-medium text-ink transition hover:border-violet hover:text-violet">
              {s.name}
            </a>
          ))}
          <a href={ASESORIA_PATH} class="rounded-full border border-ink/12 bg-white/50 px-5 py-2.5 text-[1rem] font-medium text-ink transition hover:border-violet hover:text-violet">
            Asesoría de procesos y automatización
          </a>
        </div>
      </div>
    </div>
  </section>
</Layout>

<style>
  .service-light {
    background:
      radial-gradient(45% 40% at 55% 45%, rgba(109, 85, 255, 0.24), transparent 70%),
      radial-gradient(30% 30% at 75% 80%, rgba(63, 211, 191, 0.1), transparent 70%);
    filter: blur(20px);
  }
  .bridge-light {
    background:
      radial-gradient(50% 80% at 90% 10%, rgba(109, 85, 255, 0.45), transparent 70%),
      radial-gradient(40% 60% at 0% 100%, rgba(63, 211, 191, 0.14), transparent 70%);
  }
</style>
