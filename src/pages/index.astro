---
import Layout from "../layouts/Layout.astro";
import ServicesCarousel from "../components/ServicesCarousel.tsx";
import AnimatedTagline from "../components/AnimatedTagline.tsx";
import { homeTagline } from "../data/services";
import { publishedBlogPosts } from "../data/blog";

const latestPosts = [...publishedBlogPosts]
  .sort((a, b) => new Date(b.datePublished).getTime() - new Date(a.datePublished).getTime())
  .slice(0, 3);

const diferenciadores = [
  {
    title: "Especialistas locales",
    text: "Conocemos el tejido empresarial de Andalucía porque trabajamos codo con codo con él.",
  },
  {
    title: "Resultados globales",
    text: "Aplicamos IA, automatización y estrategia digital de nivel internacional a negocios locales.",
  },
  {
    title: "No somos una agencia genérica",
    text: "Cada proyecto se diseña a medida: sin plantillas ni servicios enlatados.",
  },
];
---

<Layout title="Albariza Digital — Digitalizamos tu negocio" ambientGlow>
  <!-- Hero -->
  <section class="mx-auto max-w-6xl px-6 pb-8 pt-16 text-center sm:pt-24">
    <AnimatedTagline client:load normal={homeTagline.normal} emphasis={homeTagline.emphasis} />
    <p class="mx-auto mt-6 max-w-2xl text-base text-white/60 sm:text-lg">
      Marketing digital, inteligencia artificial y consultoría estratégica. Todo lo que tu
      negocio necesita para crecer online.
    </p>
  </section>

  <!-- Carrusel de servicios -->
  <section id="servicios" class="px-4 py-14 sm:py-20">
    <h2 class="mb-10 text-center font-serif text-2xl italic sm:text-3xl">
      Explora <span class="not-italic text-white/50">nuestros servicios</span>
    </h2>
    <ServicesCarousel client:load />
  </section>

  <!-- Diferenciadores -->
  <section id="nosotros" class="border-t border-white/10 px-6 py-16">
    <div class="mx-auto grid max-w-5xl gap-8 sm:grid-cols-3">
      {diferenciadores.map((d, i) => (
        <div
          data-reveal
          data-reveal-delay={i * 120}
          class="rounded-2xl border border-white/10 bg-white/[0.03] p-6"
        >
          <h3 class="font-serif text-lg">{d.title}</h3>
          <p class="mt-2 text-sm text-white/60">{d.text}</p>
        </div>
      ))}
    </div>
  </section>

  <!-- Consultoría gratuita -->
  <section class="border-t border-white/10 px-6 py-20 text-center">
    <div data-reveal>
      <h2 class="font-serif text-3xl sm:text-4xl">Cuéntanos tu proyecto</h2>
      <p class="mx-auto mt-4 max-w-xl text-white/60">
        Analizamos tu situación digital sin compromiso en una consultoría de 30 minutos.
      </p>
      <a
        href="#contacto"
        class="mt-8 inline-block rounded-full bg-white px-8 py-3 text-sm font-semibold uppercase tracking-wide text-black transition hover:bg-white/90"
      >
        Reservar mi consultoría gratis →
      </a>
    </div>
  </section>

  <!-- Blog -->
  <section id="blog" class="border-t border-white/10 px-6 py-20 text-center">
    <div data-reveal>
      <h2 class="font-serif text-2xl sm:text-3xl">Blog</h2>
      <p class="mx-auto mt-4 max-w-xl text-white/60">
        Artículos sobre marketing digital, inteligencia artificial y estrategia para hacer crecer tu negocio.
      </p>
    </div>

    <div class="mx-auto mt-10 grid max-w-5xl gap-6 text-left sm:grid-cols-3">
      {latestPosts.map((post, i) => (
        <a
          href={`/blog/${post.slug}`}
          data-reveal
          data-reveal-delay={i * 120}
          class="group rounded-2xl border border-white/10 bg-white/[0.03] p-5 transition hover:border-white/25 hover:bg-white/[0.05]"
        >
          <span class="text-[11px] font-medium uppercase tracking-[0.2em] text-white/50">
            {post.categoryLabel}
          </span>
          <h3 class="mt-2 font-serif text-base leading-snug transition group-hover:text-white">
            {post.title}
          </h3>
        </a>
      ))}
    </div>

    <a
      href="/blog"
      data-reveal
      data-reveal-delay="360"
      class="mt-10 inline-block rounded-full border border-white/20 px-8 py-3 text-sm font-semibold uppercase tracking-wide transition hover:bg-white hover:text-black"
    >
      Leer nuestro blog →
    </a>
  </section>

  <!-- Contacto -->
  <section id="contacto" class="border-t border-white/10 px-6 py-20 text-center">
    <div data-reveal>
      <h2 class="font-serif text-2xl sm:text-3xl">Contactar con Albariza Digital</h2>
      <p class="mt-4 text-white/60">
        <a href="tel:+34601386534" class="underline decoration-white/30 underline-offset-4">+34 601 386 534</a>
      </p>
      <p class="mt-2 text-white/60">
        <a href="mailto:albarizadigital@gmail.com" class="underline decoration-white/30 underline-offset-4">albarizadigital@gmail.com</a>
      </p>
    </div>
  </section>
</Layout>
