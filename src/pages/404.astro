---
import Layout from "../layouts/Layout.astro";
import { ASESORIA_PATH } from "../data/routes";

const links = [
  { label: "Inicio", href: "/" },
  { label: "Asesoría", href: ASESORIA_PATH },
  { label: "Blog", href: "/blog" },
  { label: "Contacto", href: "/contacto" },
];
---

<Layout title="Página no encontrada | Albariza Digital" description="La página que buscas no existe o se ha movido." noindex theme="light">
  <section class="relative overflow-x-clip">
    <div aria-hidden="true" class="nf-light pointer-events-none absolute inset-0"></div>
    <div class="relative mx-auto flex min-h-[70vh] max-w-3xl flex-col items-center justify-center px-6 py-24 text-center">
      <p class="text-[clamp(6rem,18vw,11rem)] font-bold leading-none tracking-[-0.06em] text-ink/10" aria-hidden="true">404</p>
      <h1 class="-mt-4 text-[clamp(2.2rem,5vw,3.6rem)] font-bold leading-[1.02]">Esta página se ha perdido entre WhatsApps.</h1>
      <p class="mt-5 max-w-[46ch] text-[1.12rem] leading-relaxed text-graphite">
        Puede que el enlace esté roto o que la página se haya movido. Desde aquí puedes volver a algo que sí existe.
      </p>
      <ul class="mt-9 flex flex-wrap justify-center gap-3">
        {links.map((l, i) => (
          <li>
            <a
              href={l.href}
              class:list={[
                "inline-block rounded-full px-6 py-3 text-[1rem] font-semibold transition",
                i === 0 ? "bg-violet text-white shadow-[0_14px_30px_-12px_rgba(79,50,224,0.7)] hover:bg-ink" : "border border-ink/12 bg-white/60 text-ink hover:border-violet hover:text-violet",
              ]}
            >
              {l.label}
            </a>
          </li>
        ))}
      </ul>
    </div>
  </section>
</Layout>

<style>
  .nf-light {
    background: radial-gradient(40% 50% at 50% 45%, rgba(109, 85, 255, 0.2), transparent 70%);
    filter: blur(20px);
  }
</style>
