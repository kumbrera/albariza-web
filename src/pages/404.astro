---
import Layout from "../layouts/Layout.astro";
---

<Layout title="Página no encontrada — Albariza Digital" description="La página que buscas no existe o se ha movido." noindex>
  <section class="mx-auto flex min-h-[60vh] max-w-xl flex-col items-center justify-center px-6 text-center">
    <span class="font-serif text-6xl text-white/20">404</span>
    <h1 class="mt-4 font-serif text-2xl sm:text-3xl">Esta página no existe</h1>
    <p class="mt-4 text-white/60">
      Puede que el enlace esté roto o que la página se haya movido. Vuelve al inicio y prueba desde ahí.
    </p>
    <a
      href="/"
      class="mt-8 inline-block rounded-full bg-white px-8 py-3 text-sm font-semibold uppercase tracking-wide text-black transition hover:bg-white/90"
    >
      ← Volver al inicio
    </a>
  </section>
</Layout>
