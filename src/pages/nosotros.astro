---
import Layout from "../layouts/Layout.astro";
import StepMetrics from "../components/home/StepMetrics.tsx";
import StepQuote from "../components/StepQuote.astro";
import Lanyard from "../components/Lanyard.tsx";
import { stepCase } from "../data/home";
import { aboutHero, aboutMeta, chapters, principles, team } from "../data/nosotros";
import { ORG_ID, PERSON_IDS, SITE, breadcrumbs } from "../data/schema";

const aboutLd = {
  "@context": "https://schema.org",
  "@type": "AboutPage",
  url: `${SITE}/nosotros/`,
  name: aboutMeta.title,
  about: { "@id": ORG_ID },
  mentions: [{ "@id": PERSON_IDS.pablo }, { "@id": PERSON_IDS.miguel }],
};
---

<Layout title={aboutMeta.title} description={aboutMeta.description}>
  <script type="application/ld+json" set:html={JSON.stringify(aboutLd)} />
  <script type="application/ld+json" set:html={JSON.stringify(breadcrumbs([["Inicio", "/"], ["Nosotros", "/nosotros/"]]))} />
  <!-- Hero -->
  <section class="relative overflow-x-clip">
    <div aria-hidden="true" class="about-light pointer-events-none absolute inset-x-0 top-[-20%] h-[140%]"></div>
    <div class="relative mx-auto max-w-7xl px-6 pb-20 pt-16 lg:pb-28 lg:pt-24">
      <h1 class="max-w-[14ch] text-[clamp(2.8rem,6.4vw,5.6rem)] font-bold leading-[0.95]">{aboutHero.title}</h1>
      <p class="mt-8 max-w-[52ch] text-[1.2rem] leading-relaxed text-graphite">{aboutHero.sub}</p>
    </div>
  </section>

  <!-- Historia -->
  <section class="border-t border-ink/8">
    <div class="mx-auto max-w-7xl px-6 py-24">
      <ol class="divide-y divide-ink/10">
        {chapters.map((c, i) => (
          <li class="grid gap-6 py-14 lg:grid-cols-12 lg:gap-10">
            <div class="lg:col-span-4">
              <p class="flex items-baseline gap-3 text-graphite">
                <span class="text-[0.95rem] font-semibold tabular-nums text-violet">0{i + 1}</span>
                <span class="text-[0.95rem]">{c.label}</span>
              </p>
              <h2 class="mt-3 text-[clamp(1.9rem,3.4vw,2.8rem)] font-bold leading-[1.02]">{c.title}</h2>
            </div>
            <div class="space-y-5 lg:col-span-7 lg:col-start-6">
              {c.paragraphs.map((p) => (
                <p class="text-[1.15rem] leading-relaxed text-graphite">{p}</p>
              ))}
              {i === 2 && (
                <div class="pt-8">
                  <StepMetrics client:visible={{ rootMargin: "600px" }} metrics={stepCase.metrics} />
                  <StepQuote class="mt-12" />
                </div>
              )}
            </div>
          </li>
        ))}
      </ol>
    </div>
  </section>

  <!-- Cómo trabajamos -->
  <section class="border-t border-ink/8 bg-white/40">
    <div class="mx-auto grid max-w-7xl gap-12 px-6 py-24 lg:grid-cols-12">
      <h2 class="text-[clamp(2.2rem,4.4vw,3.4rem)] font-bold leading-[1.02] lg:col-span-4">Cómo trabajamos.</h2>
      <ul class="divide-y divide-ink/10 border-y border-ink/10 lg:col-span-7 lg:col-start-6">
        {principles.map((p) => (
          <li class="py-7">
            <h3 class="text-[1.4rem] font-bold leading-tight">{p.title}</h3>
            <p class="mt-2 max-w-[56ch] text-[1.05rem] leading-relaxed text-graphite">{p.text}</p>
          </li>
        ))}
      </ul>
    </div>
  </section>

  <!-- Equipo -->
  <section class="relative overflow-x-clip border-t border-ink/8">
    <div aria-hidden="true" class="team-light pointer-events-none absolute inset-0"></div>
    <div class="relative mx-auto max-w-7xl px-6 pt-24 text-center">
      <h2 class="text-[clamp(2.2rem,4.4vw,3.6rem)] font-bold leading-[1.02]">{team.title}</h2>
      <p class="mt-3 text-[1.05rem] text-graphite">{team.sub}</p>
      <ul class="sr-only">
        {team.people.map((p) => <li>{p.name}, {p.role}</li>)}
      </ul>
    </div>
    <div class="relative [mask-image:linear-gradient(to_bottom,transparent,black_14%)]">
      <Lanyard client:visible={{ rootMargin: "1400px" }} cards={team.cards} className="h-[88vh] min-h-[620px]" />
    </div>
  </section>

  <!-- CTA -->
  <section class="border-t border-ink/8">
    <div class="mx-auto flex max-w-7xl flex-col items-start justify-between gap-8 px-6 py-24 md:flex-row md:items-center">
      <div>
        <h2 class="text-[clamp(2rem,3.6vw,3rem)] font-bold leading-[1.05]">¿Te suena lo del caos de Excel y WhatsApp?</h2>
        <p class="mt-3 max-w-[52ch] text-[1.1rem] text-graphite">En 30 minutos te decimos qué proceso ordenaríamos primero y cuánto tiempo te ahorraría.</p>
      </div>
      <a href="/contacto/" data-open-booking class="shrink-0 rounded-full bg-violet px-7 py-4 text-[1.02rem] font-semibold text-white shadow-[0_14px_30px_-12px_rgba(79,50,224,0.7)] transition hover:bg-ink">
        Reservar mi sesión gratuita
      </a>
    </div>
  </section>
</Layout>

<style>
  .about-light {
    background:
      radial-gradient(40% 50% at 80% 30%, rgba(109, 85, 255, 0.22), transparent 70%),
      radial-gradient(30% 40% at 10% 90%, rgba(63, 211, 191, 0.1), transparent 70%);
    filter: blur(10px);
  }
  .team-light {
    background: radial-gradient(45% 55% at 50% 55%, rgba(109, 85, 255, 0.18), transparent 70%);
  }
</style>
