---
import Layout from "../../layouts/Layout.astro";
import { publishedBlogPosts, readingMinutes } from "../../data/blog";

const posts = [...publishedBlogPosts].sort(
  (a, b) => new Date(b.datePublished).getTime() - new Date(a.datePublished).getTime(),
);
// Lead with the newest article on the flagship topic; the rest follow by date.
const featured = posts.find((p) => p.categorySlug === "asesoria-procesos-automatizacion") ?? posts[0];
const rest = posts.filter((p) => p !== featured);

const dateFormatter = new Intl.DateTimeFormat("es-ES", { day: "numeric", month: "long", year: "numeric" });
const fmt = (iso: string) => dateFormatter.format(new Date(iso));
---

<Layout
  title="Blog sobre procesos, automatización y captación para pymes | Albariza Digital"
  description="Artículos prácticos para pymes y autónomos: cómo ordenar procesos, qué automatizar primero, CRM, web, SEO y redes sociales."
 
>
  <section class="relative overflow-x-clip">
    <div aria-hidden="true" class="blog-light pointer-events-none absolute right-[-10%] top-[-20%] h-[140%] w-[70%]"></div>
    <div class="relative mx-auto max-w-7xl px-6 pb-16 pt-10 lg:pt-16">
      <p class="text-[1rem] font-medium text-violet">Blog</p>
      <h1 class="mt-4 max-w-[16ch] text-[clamp(2.8rem,6vw,5rem)] font-bold leading-[0.96]">Ideas para trabajar con menos caos.</h1>
      <p class="mt-6 max-w-[52ch] text-[1.15rem] leading-relaxed text-graphite">
        Artículos prácticos sobre procesos, automatización y cómo conseguir clientes, escritos para pymes y autónomos.
      </p>
    </div>
  </section>

  <section class="mx-auto max-w-7xl px-6 pb-8">
    <a
      href={`/blog/${featured.slug}`}
      class="group relative block overflow-hidden rounded-[32px] bg-ink p-8 text-white sm:p-12 lg:p-14"
    >
      <div aria-hidden="true" class="featured-light pointer-events-none absolute inset-0 transition-opacity duration-500 group-hover:opacity-80"></div>
      <div class="relative grid gap-10 lg:grid-cols-12 lg:items-end">
        <div class="lg:col-span-8">
          <p class="flex flex-wrap items-center gap-x-3 gap-y-1 text-[0.95rem] text-white/60">
            <span class="rounded-full bg-white/10 px-3 py-1 font-medium text-[#c9c0ff]">{featured.categoryLabel}</span>
            <span>{readingMinutes(featured)} min de lectura</span>
          </p>
          <h2 class="mt-6 text-[clamp(2rem,3.8vw,3.2rem)] font-bold leading-[1.02] tracking-[-0.045em]">{featured.title}</h2>
          <p class="mt-5 max-w-[56ch] text-[1.1rem] leading-relaxed text-white/70">{featured.excerpt}</p>
        </div>
        <div class="lg:col-span-4 lg:text-right">
          <span class="inline-flex items-center gap-2 rounded-full bg-white px-6 py-3.5 text-[1rem] font-semibold text-ink transition group-hover:bg-[#c9c0ff]">
            Leer el artículo <span aria-hidden="true" class="transition group-hover:translate-x-1">→</span>
          </span>
        </div>
      </div>
    </a>
  </section>

  <section class="mx-auto max-w-7xl px-6 pb-28 pt-8">
    <ul class="divide-y divide-ink/10 border-y border-ink/10">
      {rest.map((post) => (
        <li>
          <a href={`/blog/${post.slug}`} class="group grid gap-3 py-9 md:grid-cols-12 md:gap-8">
            <div class="text-[0.92rem] text-graphite md:col-span-3">
              <p class="font-medium text-violet">{post.categoryLabel}</p>
              <p class="mt-1">
                <time datetime={post.datePublished}>{fmt(post.datePublished)}</time> · {readingMinutes(post)} min
              </p>
            </div>
            <div class="md:col-span-8">
              <h2 class="text-[clamp(1.4rem,2.4vw,1.9rem)] font-bold leading-[1.1] tracking-[-0.035em] text-ink transition group-hover:text-violet">{post.title}</h2>
              <p class="mt-3 max-w-[64ch] text-[1.04rem] leading-relaxed text-graphite">{post.excerpt}</p>
            </div>
            <span aria-hidden="true" class="hidden self-center justify-self-end text-[1.4rem] text-graphite transition group-hover:translate-x-1 group-hover:text-violet md:col-span-1 md:block">→</span>
          </a>
        </li>
      ))}
    </ul>
  </section>
</Layout>

<style>
  .blog-light {
    background:
      radial-gradient(45% 40% at 60% 45%, rgba(109, 85, 255, 0.22), transparent 70%),
      radial-gradient(30% 30% at 80% 80%, rgba(63, 211, 191, 0.1), transparent 70%);
    filter: blur(20px);
  }
  .featured-light {
    background:
      radial-gradient(55% 80% at 90% 0%, rgba(109, 85, 255, 0.5), transparent 70%),
      radial-gradient(40% 60% at 0% 100%, rgba(63, 211, 191, 0.16), transparent 70%);
  }
</style>
