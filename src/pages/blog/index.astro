---
import Layout from "../../layouts/Layout.astro";
import { publishedBlogPosts } from "../../data/blog";

const posts = [...publishedBlogPosts].sort(
  (a, b) => new Date(b.datePublished).getTime() - new Date(a.datePublished).getTime()
);

const dateFormatter = new Intl.DateTimeFormat("es-ES", {
  day: "numeric",
  month: "long",
  year: "numeric",
});
---

<Layout
  title="Blog — Marketing digital, IA y estrategia | Albariza Digital"
  description="Artículos prácticos sobre automatización, posicionamiento SEO/GEO y redes sociales para pymes de Cádiz, Sevilla, Jerez y Málaga."
>
  <section class="mx-auto max-w-5xl px-6 pb-8 pt-16 text-center sm:pt-24">
    <h1 class="font-serif text-4xl leading-tight sm:text-5xl">Blog</h1>
    <p class="mx-auto mt-6 max-w-2xl text-base text-white/60 sm:text-lg">
      Artículos prácticos sobre marketing digital, inteligencia artificial y estrategia,
      pensados para pymes que quieren crecer online.
    </p>
  </section>

  <section class="mx-auto max-w-5xl px-6 pb-24 pt-8">
    <div class="grid gap-6 sm:grid-cols-2">
      {posts.map((post) => (
        <a
          href={`/blog/${post.slug}`}
          class="group flex flex-col rounded-2xl border border-white/10 bg-white/[0.03] p-6 transition hover:border-white/25 hover:bg-white/[0.05]"
        >
          <span class="text-xs font-medium uppercase tracking-[0.2em] text-white/50">
            {post.categoryLabel}
          </span>
          <h2 class="mt-3 font-serif text-xl leading-snug transition group-hover:text-white">
            {post.title}
          </h2>
          <p class="mt-3 flex-1 text-sm text-white/60">{post.excerpt}</p>
          <div class="mt-5 flex items-center justify-between text-xs text-white/40">
            <time datetime={post.datePublished}>{dateFormatter.format(new Date(post.datePublished))}</time>
            <span class="font-semibold text-white/70 transition group-hover:text-white">Leer más →</span>
          </div>
        </a>
      ))}
    </div>
  </section>
</Layout>
