---
import Layout from "../layouts/Layout.astro";
import ContactPanel from "../components/ContactPanel.tsx";

const whatsapp = `https://wa.me/34601386534?text=${encodeURIComponent("Hola Albariza, me gustaría hablar sobre mi empresa.")}`;

const channels = [
  { label: "Llámanos", value: "601 386 534", href: "tel:+34601386534", icon: "phone" },
  { label: "WhatsApp", value: "Escríbenos cuando quieras", href: whatsapp, icon: "whatsapp", external: true },
  { label: "Email", value: "albarizadigital@gmail.com", href: "mailto:albarizadigital@gmail.com", icon: "mail" },
];

const next = [
  { title: "Te escribimos", text: "Para cerrar día y hora, o para preguntarte lo que nos falte." },
  { title: "Hablamos 30 minutos", text: "Nos cuentas cómo trabajáis y qué os roba tiempo. Sin presentación comercial." },
  { title: "Te decimos por dónde empezar", text: "Qué haríamos primero, cuánto te ahorraría y qué costaría. Tú decides." },
];
---

<Layout
  title="Contacto | Albariza Digital"
  description="Reserva tu sesión de asesoría gratuita de 30 minutos o cuéntanos qué necesitas en web, SEO o redes. También por teléfono, WhatsApp o email."
  theme="light"
>
  <section class="relative overflow-x-clip">
    <div aria-hidden="true" class="contact-light pointer-events-none absolute right-[-10%] top-[-10%] h-[120%] w-[80%]"></div>
    <div class="relative mx-auto grid max-w-7xl items-start gap-12 px-6 pb-24 pt-10 lg:grid-cols-12 lg:gap-12 lg:pt-16">
      <div class="lg:col-span-5 lg:pt-6">
        <p class="text-[1rem] font-medium text-violet">Contacto</p>
        <h1 class="mt-4 text-[clamp(3rem,6vw,5.2rem)] font-bold leading-[0.95]">Hablemos.</h1>
        <p class="mt-6 max-w-[40ch] text-[1.15rem] leading-relaxed text-graphite">
          Cuéntanos qué te pasa y te decimos por dónde empezaríamos. Si lo prefieres, llámanos o escríbenos por WhatsApp.
        </p>

        <ul class="mt-10 divide-y divide-ink/10 border-y border-ink/10">
          {channels.map((c) => (
            <li>
              <a
                href={c.href}
                {...(c.external ? { target: "_blank", rel: "noopener noreferrer" } : {})}
                class="group flex items-center gap-4 py-5"
              >
                <span class="flex h-11 w-11 shrink-0 items-center justify-center rounded-xl bg-white text-ink shadow-[0_6px_16px_-10px_rgba(22,21,31,0.5)] transition group-hover:bg-violet group-hover:text-white">
                  {c.icon === "phone" && (
                    <svg width="19" height="19" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.9" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M22 16.92v3a2 2 0 0 1-2.18 2 19.79 19.79 0 0 1-8.63-3.07 19.5 19.5 0 0 1-6-6 19.79 19.79 0 0 1-3.07-8.67A2 2 0 0 1 4.11 2h3a2 2 0 0 1 2 1.72 12.84 12.84 0 0 0 .7 2.81 2 2 0 0 1-.45 2.11L8.09 9.91a16 16 0 0 0 6 6l1.27-1.27a2 2 0 0 1 2.11-.45 12.84 12.84 0 0 0 2.81.7A2 2 0 0 1 22 16.92z" /></svg>
                  )}
                  {c.icon === "whatsapp" && (
                    <svg width="19" height="19" viewBox="0 0 24 24" fill="currentColor" aria-hidden="true"><path d="M12.04 2C6.58 2 2.13 6.45 2.13 11.91c0 1.75.46 3.45 1.32 4.95L2 22l5.29-1.39a9.9 9.9 0 0 0 4.75 1.21h.01c5.46 0 9.91-4.45 9.91-9.91 0-2.65-1.03-5.14-2.9-7.01A9.82 9.82 0 0 0 12.04 2Zm0 18.15h-.01a8.2 8.2 0 0 1-4.19-1.15l-.3-.18-3.14.82.84-3.06-.2-.31a8.22 8.22 0 0 1-1.26-4.36c0-4.55 3.71-8.26 8.27-8.26 2.21 0 4.28.86 5.84 2.42a8.2 8.2 0 0 1 2.42 5.85c0 4.56-3.71 8.27-8.27 8.27Zm4.53-6.2c-.25-.12-1.47-.72-1.7-.81-.23-.08-.39-.12-.56.13-.17.25-.64.81-.78.97-.14.17-.29.19-.53.06-.25-.12-1.05-.39-2-1.23-.74-.66-1.24-1.47-1.38-1.72-.15-.25-.02-.38.11-.51.11-.11.25-.29.37-.43.12-.15.16-.25.25-.42.08-.17.04-.31-.02-.43-.06-.12-.56-1.36-.77-1.86-.2-.48-.41-.42-.56-.43h-.48c-.17 0-.43.06-.66.31-.22.25-.86.85-.86 2.07 0 1.22.89 2.4 1.01 2.57.12.17 1.75 2.67 4.23 3.74.59.26 1.05.41 1.41.52.59.19 1.13.16 1.55.1.47-.07 1.47-.6 1.68-1.18.21-.58.21-1.07.15-1.18-.06-.1-.23-.17-.48-.29Z" /></svg>
                  )}
                  {c.icon === "mail" && (
                    <svg width="19" height="19" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.9" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><rect x="2" y="4" width="20" height="16" rx="2" /><path d="m22 7-10 6L2 7" /></svg>
                  )}
                </span>
                <span class="min-w-0">
                  <span class="block text-[0.88rem] text-graphite">{c.label}</span>
                  <span class="block truncate text-[1.12rem] font-semibold text-ink transition group-hover:text-violet">{c.value}</span>
                </span>
                <span aria-hidden="true" class="ml-auto text-graphite transition group-hover:translate-x-1 group-hover:text-violet">→</span>
              </a>
            </li>
          ))}
        </ul>
      </div>

      <div class="lg:col-span-7">
        <ContactPanel client:load />
      </div>
    </div>
  </section>

  <section class="border-t border-ink/8 bg-white/40">
    <div class="mx-auto max-w-7xl px-6 py-24">
      <h2 class="text-[clamp(2rem,3.8vw,3rem)] font-bold leading-[1.02]">Qué pasa después.</h2>
      <ol class="mt-12 grid gap-10 border-t border-ink/10 pt-10 md:grid-cols-3">
        {next.map((step, i) => (
          <li>
            <span class="flex h-11 w-11 items-center justify-center rounded-full bg-ink text-[1rem] font-semibold text-white">{i + 1}</span>
            <h3 class="mt-6 text-[1.4rem] font-bold leading-tight tracking-[-0.03em]">{step.title}</h3>
            <p class="mt-3 max-w-[36ch] text-[1.04rem] leading-relaxed text-graphite">{step.text}</p>
          </li>
        ))}
      </ol>
    </div>
  </section>
</Layout>

<style>
  .contact-light {
    background:
      radial-gradient(45% 40% at 60% 40%, rgba(109, 85, 255, 0.24), transparent 70%),
      radial-gradient(30% 30% at 80% 85%, rgba(63, 211, 191, 0.12), transparent 70%);
    filter: blur(20px);
  }
</style>
