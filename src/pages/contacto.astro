---
import Layout from "../layouts/Layout.astro";

const zonas = [
  "Cádiz capital",
  "Jerez de la Frontera",
  "Chiclana de la Frontera",
  "Sevilla",
  "Málaga",
  "Otra zona de Andalucía",
  "Fuera de Andalucía",
];

const serviceGroups = [
  {
    label: "Marketing Digital",
    options: [
      "Posicionamiento SEO",
      "Creación de Página Web",
      "Gestión de Redes Sociales",
      "Campañas Publicitarias (Google / Meta / TikTok)",
      "Social Commerce",
      "Tienda Online / eCommerce",
    ],
  },
  {
    label: "IA & Automatización",
    options: [
      "IA Generativa para mi empresa",
      "Chatbot o Asistente Virtual",
      "Automatización de Procesos (RPA)",
      "Desarrollo No-Code / Low-Code",
    ],
  },
  {
    label: "Consultoría",
    options: [
      "Consultoría de Digitalización",
      "CRM a medida",
      "ERP / Sistema de Gestión",
      "Integración de Sistemas",
      "Formación y Coaching Online",
    ],
  },
];
---

<Layout
  title="Contacto — Albariza Digital"
  description="Cuéntanos tu proyecto o reserva una consultoría gratuita de 30 minutos. Te respondemos en menos de 24h."
>
  <section class="relative">
    <div
      class="pointer-events-none absolute left-1/2 top-0 h-[420px] w-[420px] -translate-x-1/2 rounded-full bg-violet-500 opacity-20 blur-[110px]"
      aria-hidden="true"
    >
    </div>
    <div class="relative mx-auto max-w-3xl px-6 pb-6 pt-16 text-center sm:pt-24">
      <h1 class="font-serif text-4xl leading-tight sm:text-5xl">Hablemos de tu proyecto</h1>
      <p class="mx-auto mt-4 max-w-xl text-white/60">
        Rellena el formulario, o si prefieres algo más rápido, reserva directamente 30
        minutos con nosotros. Respondemos en menos de 24h.
      </p>
    </div>
  </section>

  <section class="px-6 pb-24 pt-6">
    <div class="mx-auto grid max-w-5xl items-start gap-8 lg:grid-cols-[1fr_340px]">
      <!-- Formulario principal: "Cuéntanos tu proyecto" — tarjeta clara sobre el fondo
           oscuro, mismo recurso que ya usamos en la página de SEO/GEO para romper el negro. -->
      <div
        data-reveal
        class="rounded-3xl p-6 sm:p-10"
        style="background: linear-gradient(160deg, #f8f4ec, #efe8da);"
      >
        <h2 class="font-serif text-2xl text-[#1a1a1a] sm:text-3xl">Cuéntanos tu proyecto</h2>
        <p class="mt-2 text-sm text-[#5a5a5a]">
          Rellena el formulario y te preparamos una propuesta personalizada.
        </p>

        <form id="project-form" class="mt-8 space-y-5">
          <input type="checkbox" name="botcheck" class="hidden" style="display:none" tabindex="-1" autocomplete="off" />

          <div class="grid gap-5 sm:grid-cols-2">
            <label class="block">
              <span class="text-sm font-semibold text-[#1a1a1a]">Nombre *</span>
              <input
                type="text"
                name="nombre"
                required
                placeholder="Tu nombre"
                class="mt-1.5 w-full rounded-xl border border-[#1a1a1a]/15 bg-white px-4 py-3 text-[#1a1a1a] placeholder-[#9a9a9a] outline-none transition focus:border-[#1a1a1a]/40"
              />
            </label>
            <label class="block">
              <span class="text-sm font-semibold text-[#1a1a1a]">Empresa</span>
              <input
                type="text"
                name="empresa"
                placeholder="Tu empresa"
                class="mt-1.5 w-full rounded-xl border border-[#1a1a1a]/15 bg-white px-4 py-3 text-[#1a1a1a] placeholder-[#9a9a9a] outline-none transition focus:border-[#1a1a1a]/40"
              />
            </label>
          </div>

          <div class="grid gap-5 sm:grid-cols-2">
            <label class="block">
              <span class="text-sm font-semibold text-[#1a1a1a]">Email *</span>
              <input
                type="email"
                name="email"
                required
                placeholder="correo@empresa.com"
                class="mt-1.5 w-full rounded-xl border border-[#1a1a1a]/15 bg-white px-4 py-3 text-[#1a1a1a] placeholder-[#9a9a9a] outline-none transition focus:border-[#1a1a1a]/40"
              />
            </label>
            <label class="block">
              <span class="text-sm font-semibold text-[#1a1a1a]">Teléfono</span>
              <input
                type="tel"
                name="telefono"
                placeholder="600 000 000"
                class="mt-1.5 w-full rounded-xl border border-[#1a1a1a]/15 bg-white px-4 py-3 text-[#1a1a1a] placeholder-[#9a9a9a] outline-none transition focus:border-[#1a1a1a]/40"
              />
            </label>
          </div>

          <label class="block">
            <span class="text-sm font-semibold text-[#1a1a1a]">Ciudad / Zona</span>
            <div class="relative mt-1.5">
              <select
                name="zona"
                class="w-full appearance-none rounded-xl border border-[#1a1a1a]/15 bg-white px-4 py-3 text-[#1a1a1a] outline-none transition focus:border-[#1a1a1a]/40"
              >
                <option value="">Selecciona tu zona</option>
                {zonas.map((z) => <option value={z}>{z}</option>)}
              </select>
              <svg class="pointer-events-none absolute right-4 top-1/2 h-4 w-4 -translate-y-1/2 text-[#1a1a1a]/50" viewBox="0 0 24 24" fill="none">
                <path d="M6 9l6 6 6-6" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" />
              </svg>
            </div>
          </label>

          <label class="block">
            <span class="text-sm font-semibold text-[#1a1a1a]">¿Qué servicio te interesa?</span>
            <div class="relative mt-1.5">
              <select
                name="servicio"
                class="w-full appearance-none rounded-xl border border-[#1a1a1a]/15 bg-white px-4 py-3 text-[#1a1a1a] outline-none transition focus:border-[#1a1a1a]/40"
              >
                <option value="">Selecciona un servicio</option>
                {serviceGroups.map((group) => (
                  <optgroup label={group.label}>
                    {group.options.map((opt) => <option value={opt}>{opt}</option>)}
                  </optgroup>
                ))}
                <option value="No sé aún / Necesito orientación">No sé aún / Necesito orientación</option>
              </select>
              <svg class="pointer-events-none absolute right-4 top-1/2 h-4 w-4 -translate-y-1/2 text-[#1a1a1a]/50" viewBox="0 0 24 24" fill="none">
                <path d="M6 9l6 6 6-6" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" />
              </svg>
            </div>
          </label>

          <label class="block">
            <span class="text-sm font-semibold text-[#1a1a1a]">Cuéntanos tu proyecto *</span>
            <textarea
              name="mensaje"
              required
              rows="4"
              placeholder="Describe tu negocio, qué necesitas o qué problema quieres resolver. Cuanta más info, mejor podremos ayudarte."
              class="mt-1.5 w-full rounded-xl border border-[#1a1a1a]/15 bg-white px-4 py-3 text-[#1a1a1a] placeholder-[#9a9a9a] outline-none transition focus:border-[#1a1a1a]/40"
            ></textarea>
          </label>

          <button
            type="submit"
            class="w-full rounded-xl bg-[#1a1a1a] px-8 py-4 text-sm font-semibold uppercase tracking-wide text-white transition hover:bg-[#1a1a1a]/85"
          >
            Enviar mensaje →
          </button>

          <p id="project-form-status" class="min-h-[1.25em] text-sm" role="status"></p>

          <p class="text-xs text-[#7a7a7a]">
            Al enviar aceptas que usemos tus datos para responderte, según nuestra{" "}
            <a href="/politica-privacidad" class="underline decoration-[#7a7a7a]/50 underline-offset-2">
              política de privacidad
            </a>
            . Sin spam, nunca.
          </p>
        </form>
      </div>

      <!-- Formulario compacto: reserva rápida, para quien no quiere rellenar tanto -->
      <div
        data-reveal
        data-reveal-delay="150"
        class="rounded-3xl border border-white/10 bg-white/[0.03] p-6 sm:sticky sm:top-24 sm:p-8"
      >
        <h2 class="font-serif text-xl sm:text-2xl">Reserva tu consultoría gratuita</h2>
        <p class="mt-2 text-sm text-white/60">
          30 minutos. Sin compromiso. Analizamos tu negocio online.
        </p>

        <form id="booking-form" class="mt-6 space-y-3">
          <input type="checkbox" name="botcheck" class="hidden" style="display:none" tabindex="-1" autocomplete="off" />

          <input
            type="text"
            name="nombre"
            required
            placeholder="Tu nombre"
            class="w-full rounded-xl border border-white/15 bg-white px-4 py-3 text-[#1a1a1a] placeholder-[#9a9a9a] outline-none transition focus:border-white/40"
          />
          <input
            type="email"
            name="email"
            required
            placeholder="Tu email"
            class="w-full rounded-xl border border-white/15 bg-white px-4 py-3 text-[#1a1a1a] placeholder-[#9a9a9a] outline-none transition focus:border-white/40"
          />
          <input
            type="tel"
            name="telefono"
            placeholder="Tu teléfono"
            class="w-full rounded-xl border border-white/15 bg-white px-4 py-3 text-[#1a1a1a] placeholder-[#9a9a9a] outline-none transition focus:border-white/40"
          />

          <button
            type="submit"
            class="w-full rounded-full bg-white px-6 py-3 text-sm font-semibold uppercase tracking-wide text-black transition hover:bg-white/90"
          >
            Reservar consultoría gratuita →
          </button>

          <p id="booking-form-status" class="min-h-[1.25em] text-sm" role="status"></p>
        </form>

        <div class="mt-6 space-y-1 border-t border-white/10 pt-6 text-sm text-white/50">
          <a href="tel:+34601386534" class="block underline decoration-white/30 underline-offset-4">
            +34 601 386 534
          </a>
          <a href="mailto:albarizadigital@gmail.com" class="block underline decoration-white/30 underline-offset-4">
            albarizadigital@gmail.com
          </a>
        </div>
      </div>
    </div>
  </section>

  <script>
    // Static site, no backend — form submissions go out client-side to Web3Forms
    // (web3forms.com), which relays them by email to albarizadigital@gmail.com.
    const WEB3FORMS_ACCESS_KEY = "f9022aa9-8b7b-416b-9c2d-3930ab6193b6";

    function wireForm(formId: string, statusId: string, subject: string) {
      const form = document.getElementById(formId) as HTMLFormElement | null;
      const status = document.getElementById(statusId);
      if (!form || !status) return;

      form.addEventListener("submit", async (e) => {
        e.preventDefault();
        const btn = form.querySelector<HTMLButtonElement>('button[type="submit"]');
        const originalLabel = btn?.textContent ?? "";
        if (btn) {
          btn.disabled = true;
          btn.textContent = "Enviando...";
        }
        status.textContent = "";
        status.className = "min-h-[1.25em] text-sm";

        const payload = Object.fromEntries(new FormData(form).entries()) as Record<string, unknown>;
        payload.access_key = WEB3FORMS_ACCESS_KEY;
        payload.subject = subject;
        payload.from_name = "Web Albariza Digital";

        try {
          if (WEB3FORMS_ACCESS_KEY.startsWith("REPLACE_")) {
            throw new Error("not-configured");
          }
          const res = await fetch("https://api.web3forms.com/submit", {
            method: "POST",
            headers: { "Content-Type": "application/json", Accept: "application/json" },
            body: JSON.stringify(payload),
          });
          const result = await res.json();
          if (!result.success) throw new Error(result.message || "unknown");

          form.reset();
          status.textContent = "¡Gracias! Te responderemos lo antes posible.";
          status.classList.add("text-emerald-500");
          // Only fires if the visitor accepted analytics cookies (gtag is undefined otherwise).
          window.gtag?.("event", "form_submit", { form_name: formId });
        } catch {
          status.textContent =
            "No se pudo enviar. Escríbenos directamente a albarizadigital@gmail.com o al 601 386 534.";
          status.classList.add("text-red-400");
        } finally {
          if (btn) {
            btn.disabled = false;
            btn.textContent = originalLabel;
          }
        }
      });
    }

    wireForm("project-form", "project-form-status", "Nueva consulta — Cuéntanos tu proyecto");
    wireForm("booking-form", "booking-form-status", "Nueva reserva — Consultoría gratuita");
  </script>
</Layout>
