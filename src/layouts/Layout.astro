---
import "../styles/global.css";
import FilmGrain from "../components/FilmGrain.astro";
import LocalBusinessSchema from "../components/LocalBusinessSchema.astro";
import WhatsAppButton from "../components/WhatsAppButton.astro";
import CookieConsent from "../components/CookieConsent.astro";
import SiteNav from "../components/SiteNav.tsx";
import BookingDialog from "../components/BookingDialog.tsx";
import SiteFooter from "../components/SiteFooter.astro";
// Preloaded so Geist is ready for the first paint: swapping in late re-flowed the hero and
// shifted the layout (CLS).
import geistLatin from "@fontsource-variable/geist/files/geist-latin-wght-normal.woff2?url";

interface Props {
  title: string;
  description?: string;
  /** Title for link previews (WhatsApp, LinkedIn...) when it should read differently from the SEO title. */
  ogTitle?: string;
  /** "article" for blog posts so crawlers/AI engines pick up article-specific OG data */
  ogType?: "website" | "article";
  publishedTime?: string;
  /** True only for the 404 page — keeps it out of search results even if something
      links to it by mistake (it's also excluded from the sitemap separately). */
  noindex?: boolean;
}

const {
  title,
  ogTitle = title,
  description = "Asesoría de procesos y automatización para pymes y autónomos: ordenamos cómo trabaja tu empresa y automatizamos las tareas repetitivas.",
  ogType = "website",
  publishedTime,
  noindex = false,
} = Astro.props;

const canonicalURL = new URL(Astro.url.pathname, Astro.url);
const ogImage = new URL("/brand/og-image.jpg", Astro.url);
const ogImageAlt = "Albariza: ponemos orden en cómo trabaja tu empresa. Asesoría de procesos y automatización para pymes y autónomos.";
---

<html lang="es" class="theme-light">
  <head>
    <meta charset="utf-8" />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <link rel="icon" href="/favicon.ico" />
    <link rel="icon" type="image/png" sizes="48x48" href="/brand/favicon-48.png" />
    <link rel="icon" type="image/png" sizes="192x192" href="/brand/favicon-192.png" />
    <link rel="apple-touch-icon" href="/apple-touch-icon.png" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <link rel="preload" href={geistLatin} as="font" type="font/woff2" crossorigin />
    <meta name="description" content={description} />
    <meta
      name="robots"
      content={noindex ? "noindex, nofollow" : "index, follow, max-image-preview:large, max-snippet:-1, max-video-preview:-1"}
    />
    <meta name="generator" content={Astro.generator} />
    <link rel="canonical" href={canonicalURL} />
    <LocalBusinessSchema />

    <meta property="og:type" content={ogType} />
    <meta property="og:site_name" content="Albariza Digital" />
    <meta property="og:title" content={ogTitle} />
    <meta property="og:description" content={description} />
    <meta property="og:url" content={canonicalURL} />
    <meta property="og:locale" content="es_ES" />
    <meta property="og:image" content={ogImage} />
    <meta property="og:image:type" content="image/jpeg" />
    <meta property="og:image:alt" content={ogImageAlt} />
    <meta property="og:image:width" content="1200" />
    <meta property="og:image:height" content="630" />
    {publishedTime && <meta property="article:published_time" content={publishedTime} />}
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content={ogTitle} />
    <meta name="twitter:description" content={description} />
    <meta name="twitter:image" content={ogImage} />
    <meta name="twitter:image:alt" content={ogImageAlt} />
    <title>{title}</title>
  </head>
  <body class="theme-light min-h-screen antialiased">
    <div class="relative z-10">
      <SiteNav client:load path={Astro.url.pathname} />
      <BookingDialog client:load />
      <div class="h-20" aria-hidden="true"></div>

      <main>
        <slot />
      </main>

      <SiteFooter />
      <WhatsAppButton />
    </div>

    <FilmGrain />
    <CookieConsent />

    <script>
      // GA4 click tracking for phone and WhatsApp links, sitewide. Silently does nothing
      // if the visitor hasn't accepted analytics cookies (gtag stays undefined then).
      document.querySelectorAll<HTMLAnchorElement>('a[href^="tel:"]').forEach((el) => {
        el.addEventListener("click", () => {
          window.gtag?.("event", "phone_call", { phone_number: el.getAttribute("href") });
        });
      });

      document.querySelectorAll<HTMLAnchorElement>('a[href*="wa.me"]').forEach((el) => {
        el.addEventListener("click", () => {
          window.gtag?.("event", "whatsapp_click", { link_url: el.href });
        });
      });
    </script>
  </body>
</html>
