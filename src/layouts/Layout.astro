---
import "../styles/global.css";
import FilmGrain from "../components/FilmGrain.astro";
import AmbientGlow from "../components/AmbientGlow.astro";
import LocalBusinessSchema from "../components/LocalBusinessSchema.astro";
import WhatsAppButton from "../components/WhatsAppButton.astro";
import CookieConsent from "../components/CookieConsent.astro";
import SiteNav from "../components/SiteNav.tsx";
import BookingDialog from "../components/BookingDialog.tsx";

interface Props {
  title: string;
  description?: string;
  /** "article" for blog posts so crawlers/AI engines pick up article-specific OG data */
  ogType?: "website" | "article";
  publishedTime?: string;
  /** The 3 drifting colour blobs — home only. Service pages have their own single
      accent-coloured glow, and having both everywhere read as repetitive. */
  ambientGlow?: boolean;
  /** True only for the 404 page — keeps it out of search results even if something
      links to it by mistake (it's also excluded from the sitemap separately). */
  noindex?: boolean;
  /** "light" = the new albariza/chalk system (home first). Pages not yet redesigned stay "dark". */
  theme?: "dark" | "light";
}

const {
  title,
  description = "Marketing digital, inteligencia artificial y consultoría estratégica.",
  ogType = "website",
  publishedTime,
  ambientGlow = false,
  noindex = false,
  theme = "dark",
} = Astro.props;
const isLight = theme === "light";

const canonicalURL = new URL(Astro.url.pathname, Astro.url);

// Nav "active" state was hardcoded onto "Servicios" — it just stayed lit on every
// page, including /blog. Now it reflects the actual current path.
const path = Astro.url.pathname;
const isServiciosActive = path === "/" || path.startsWith("/servicios");
const isBlogActive = path.startsWith("/blog");
const isNosotrosActive = path.startsWith("/nosotros");
const navLinkClass = (active: boolean) =>
  active ? "border-b border-white pb-1 text-white transition" : "transition hover:text-white";
---

<html lang="es" class:list={[isLight && "theme-light"]}>
  <head>
    <meta charset="utf-8" />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <link rel="icon" href="/favicon.ico" />
    <link rel="apple-touch-icon" href="/apple-touch-icon.png" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="description" content={description} />
    <meta
      name="robots"
      content={noindex ? "noindex, nofollow" : "index, follow, max-image-preview:large, max-snippet:-1, max-video-preview:-1"}
    />
    <meta name="generator" content={Astro.generator} />
    <link rel="canonical" href={canonicalURL} />
    <LocalBusinessSchema />

    <meta property="og:type" content={ogType} />
    <meta property="og:site_name" content="Albariza Digital" />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:url" content={canonicalURL} />
    <meta property="og:locale" content="es_ES" />
    <meta property="og:image" content={new URL("/brand/og-image.png", Astro.url)} />
    <meta property="og:image:width" content="1200" />
    <meta property="og:image:height" content="630" />
    {publishedTime && <meta property="article:published_time" content={publishedTime} />}
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content={title} />
    <meta name="twitter:description" content={description} />
    <meta name="twitter:image" content={new URL("/brand/og-image.png", Astro.url)} />
    {!isLight && (
      <>
        <link rel="preconnect" href="https://fonts.googleapis.com" />
        <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
        <link
          href="https://fonts.googleapis.com/css2?family=Inter:wght@400;500;600;700&family=Playfair+Display:ital,wght@0,600;1,600&display=swap"
          rel="stylesheet"
        />
      </>
    )}
    <title>{title}</title>
    <noscript><style>[data-reveal] { opacity: 1 !important; transform: none !important; }</style></noscript>
  </head>
  <body class:list={["min-h-screen antialiased", isLight ? "theme-light" : "bg-[#08080a] font-sans text-white"]}>
    {ambientGlow && <AmbientGlow />}

    <div class="relative z-10">
    {isLight ? (
      <>
        <SiteNav client:load />
        <BookingDialog client:load />
        <div class="h-20" aria-hidden="true"></div>
      </>
    ) : (
    <header class="sticky top-0 z-50 border-b border-white/10 bg-[#08080a]/80 backdrop-blur">
      <div class="mx-auto flex max-w-6xl items-center justify-between px-6 py-4">
        <a href="/" class="flex items-center">
          <img src="/brand/logo-wordmark.svg" alt="Albariza Digital" class="h-7 w-auto sm:h-8" />
        </a>
        <nav class="hidden items-center gap-8 text-xs font-medium uppercase tracking-[0.15em] text-white/70 md:flex">
          <a href="/#servicios" class={navLinkClass(isServiciosActive)}>Servicios</a>
          <a href="/blog" class={navLinkClass(isBlogActive)}>Blog</a>
          <a href="/nosotros" class={navLinkClass(isNosotrosActive)}>Nosotros</a>
        </nav>
        <a
          href="/contacto"
          class="hidden rounded-full border border-white/20 px-4 py-2 text-xs font-semibold uppercase tracking-wide transition hover:bg-white hover:text-black md:inline-block"
        >
          Contacto
        </a>
        <button
          id="menu-toggle"
          type="button"
          aria-label="Abrir menú"
          aria-expanded="false"
          aria-controls="mobile-menu"
          class="-mr-2 p-2 text-white/80 transition hover:text-white md:hidden"
        >
          <svg id="menu-icon-open" width="22" height="22" viewBox="0 0 24 24" fill="none">
            <path d="M4 6h16M4 12h16M4 18h16" stroke="currentColor" stroke-width="2" stroke-linecap="round" />
          </svg>
          <svg id="menu-icon-close" width="22" height="22" viewBox="0 0 24 24" fill="none" class="hidden">
            <path d="M6 6l12 12M18 6L6 18" stroke="currentColor" stroke-width="2" stroke-linecap="round" />
          </svg>
        </button>
      </div>

      <nav
        id="mobile-menu"
        class="hidden flex-col gap-1 border-t border-white/10 px-6 py-4 text-sm font-medium uppercase tracking-[0.15em] text-white/70 md:hidden"
      >
        <a href="/#servicios" class={`rounded-lg px-2 py-3 transition hover:bg-white/5 hover:text-white ${isServiciosActive ? "bg-white/5 text-white" : ""}`}>Servicios</a>
        <a href="/blog" class={`rounded-lg px-2 py-3 transition hover:bg-white/5 hover:text-white ${isBlogActive ? "bg-white/5 text-white" : ""}`}>Blog</a>
        <a href="/nosotros" class={`rounded-lg px-2 py-3 transition hover:bg-white/5 hover:text-white ${isNosotrosActive ? "bg-white/5 text-white" : ""}`}>Nosotros</a>
        <a
          href="/contacto"
          class="mt-2 rounded-full border border-white/20 px-4 py-3 text-center transition hover:bg-white hover:text-black"
        >
          Contacto
        </a>
      </nav>
    </header>
    )}

    <main>
      <slot />
    </main>

    <footer class:list={["py-10", isLight ? "border-t border-ink/8" : "border-t border-white/10"]}>
      <div class:list={["mx-auto flex flex-col items-center justify-between gap-4 px-6 text-sm sm:flex-row", isLight ? "max-w-7xl text-graphite" : "max-w-6xl text-white/50"]}>
        <p>© {new Date().getFullYear()} Albariza Digital. Todos los derechos reservados.</p>
        <div class="flex items-center gap-4">
          <a href="/politica-privacidad" class:list={["transition", isLight ? "hover:text-ink" : "hover:text-white"]}>Política de privacidad</a>
          <a href="tel:+34601386534" class:list={["transition", isLight ? "hover:text-ink" : "hover:text-white"]}>+34 601 386 534</a>
        </div>
      </div>
    </footer>

    <WhatsAppButton />
    </div>

    <FilmGrain tone={isLight ? "chalk" : "film"} />
    <CookieConsent light={isLight} />

    <script>
      const toggle = document.getElementById("menu-toggle");
      const menu = document.getElementById("mobile-menu");
      const iconOpen = document.getElementById("menu-icon-open");
      const iconClose = document.getElementById("menu-icon-close");

      function setOpen(open: boolean) {
        if (!toggle || !menu || !iconOpen || !iconClose) return;
        menu.classList.toggle("hidden", !open);
        menu.classList.toggle("flex", open);
        iconOpen.classList.toggle("hidden", open);
        iconClose.classList.toggle("hidden", !open);
        toggle.setAttribute("aria-expanded", String(open));
        toggle.setAttribute("aria-label", open ? "Cerrar menú" : "Abrir menú");
      }

      toggle?.addEventListener("click", () => {
        setOpen(menu?.classList.contains("hidden") ?? false);
      });

      menu?.querySelectorAll("a").forEach((link) => {
        link.addEventListener("click", () => setOpen(false));
      });

      window.addEventListener("keydown", (e) => {
        if (e.key === "Escape") setOpen(false);
      });
    </script>

    <script>
      // Sitewide scroll-reveal: any element with [data-reveal] fades/rises into place
      // the first time it enters the viewport (optionally staggered via
      // [data-reveal-delay="120"], read in ms). Runs once per element, then disconnects —
      // this is an entrance effect, not a repeating scroll gimmick.
      const revealEls = document.querySelectorAll<HTMLElement>("[data-reveal]");
      const revealNow = () => revealEls.forEach((el) => el.classList.add("is-visible"));

      try {
        revealEls.forEach((el) => {
          const delay = el.dataset.revealDelay;
          if (delay) el.style.setProperty("--reveal-delay", `${Number(delay)}ms`);
        });

        if (!("IntersectionObserver" in window) || !revealEls.length) {
          revealNow();
        } else {
          const io = new IntersectionObserver(
            (entries, obs) => {
              for (const entry of entries) {
                if (entry.isIntersecting) {
                  entry.target.classList.add("is-visible");
                  obs.unobserve(entry.target);
                }
              }
            },
            { threshold: 0.15, rootMargin: "0px 0px -8% 0px" }
          );
          revealEls.forEach((el) => io.observe(el));
          // Belt-and-braces: content must never stay invisible forever. If for any
          // reason the observer hasn't revealed everything within a few seconds
          // (thrown error elsewhere on the page, a browser quirk, whatever), just
          // show it — a missed entrance animation is fine, permanently blank content
          // is not.
          window.setTimeout(revealNow, 4000);
        }
      } catch {
        revealNow();
      }
    </script>

    <script>
      // GA4 click tracking for phone and WhatsApp links, sitewide. Silently does nothing
      // if the visitor hasn't accepted analytics cookies (gtag stays undefined then).
      document.querySelectorAll<HTMLAnchorElement>('a[href^="tel:"]').forEach((el) => {
        el.addEventListener("click", () => {
          window.gtag?.("event", "phone_call", { phone_number: el.getAttribute("href") });
        });
      });

      document.querySelectorAll<HTMLAnchorElement>('a[href*="wa.me"]').forEach((el) => {
        el.addEventListener("click", () => {
          window.gtag?.("event", "whatsapp_click", { link_url: el.href });
        });
      });
    </script>
  </body>
</html>
