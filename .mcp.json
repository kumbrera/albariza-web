{
  "mcpServers": {
    "shadcn": {
      "command": "npx",
      "args": [
        "shadcn@latest",
        "mcp"
      ]
    },
    "context7": {
      "type": "stdio",
      "command": "npx",
      "args": [
        "-y",
        "@upstash/context7-mcp"
      ],
      "env": {}
    },
    "cloudflare": {
      "type": "http",
      "url": "https://mcp.cloudflare.com/mcp"
    },
    "gsc": {
      "command": "npx",
      "args": [
        "-y",
        "suganthan-gsc-mcp"
      ],
      "env": {
        "GSC_AUTH_MODE": "oauth",
        "GSC_OAUTH_SECRETS_FILE": "C:/Users/pablo/.gsc/gsc-oauth-secrets.json",
        "GSC_SITE_URL": "sc-domain:albarizadigital.com"
      }
    }
  }
}
